<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
               http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
           http://www.springframework.org/schema/context
               http://www.springframework.org/schema/context/spring-context-4.0.xsd
           http://www.springframework.org/schema/mvc
               http://www.springframework.org/schema/mvc/spring-mvc-4.0.xsd">

    <!--
        [mvc:annotation-driven 이란?]
        @Controller, @RequestMapping, @Valid, @ModelAttribute 등
        Spring MVC 어노테이션이 동작하도록 필요한 빈을 자동으로 등록합니다.
        아래 기능을 한 번에 활성화합니다:
          ① RequestMappingHandlerAdapter / RequestMappingHandlerMapping 자동 구성
          ② Bean Validation (@Valid) 자동 활성화 (Hibernate Validator가 classpath에 있으면)
          ③ JSON/XML 변환기(MessageConverter) 등록
          ④ ConversionService 등록
    -->
    <mvc:annotation-driven/>

    <!--
        [업로드 경로 등 환경별 설정값]
        root context(context-datasource.xml)의 property-placeholder는 이 하위(dispatcher-servlet) 컨텍스트의
        @Value 주입까지는 적용되지 않으므로, @Controller 에서 ${...} 를 쓰려면 여기에도 별도로 등록해야 한다.
    -->
    <context:property-placeholder location="classpath:upload.properties"/>

    <!-- egovframework.asset 패키지의 @Controller 클래스 자동 탐색 -->
    <context:component-scan base-package="egovframework.asset">
        <context:include-filter type="annotation" expression="org.springframework.stereotype.Controller"/>
        <context:exclude-filter type="annotation" expression="org.springframework.stereotype.Service"/>
        <context:exclude-filter type="annotation" expression="org.springframework.stereotype.Repository"/>
    </context:component-scan>

    <!--
        [인터셉터 설정]
        mvc:interceptors 를 사용하면 특정 URL 패턴에만 인터셉터를 적용할 수 있습니다.
        여러 인터셉터가 등록되면 위에서부터 순서대로 preHandle() 이 실행됩니다.

        ① LocaleChangeInterceptor: URL 파라미터 ?language=ko 로 언어 변경 가능
        ② LoginCheckInterceptor  : 로그인/회원가입 화면을 제외한 모든 요청에서 세션 검사
                                    (예전에는 각 컨트롤러 메서드마다 동일한 세션 체크 코드를 직접 넣었음)
        ③ AdminCheckInterceptor  : 가입승인/반려, 승인 목록 등 ADMIN 전용 경로에서 role 검사
                                    (② 뒤에 실행되므로 이 시점엔 로그인은 이미 보장된 상태)
    -->
    <mvc:interceptors>
        <mvc:interceptor>
            <mvc:mapping path="/**"/>
            <bean class="org.springframework.web.servlet.i18n.LocaleChangeInterceptor">
                <property name="paramName" value="language"/>
            </bean>
        </mvc:interceptor>

        <mvc:interceptor>
            <mvc:mapping path="/**"/>
            <mvc:exclude-mapping path="/user/loginView.do"/>
            <mvc:exclude-mapping path="/user/login.do"/>
            <mvc:exclude-mapping path="/user/registerView.do"/>
            <mvc:exclude-mapping path="/user/register.do"/>
            <bean class="egovframework.asset.cmmn.LoginCheckInterceptor"/>
        </mvc:interceptor>

        <mvc:interceptor>
            <mvc:mapping path="/user/pendingList.do"/>
            <mvc:mapping path="/user/approve.do"/>
            <mvc:mapping path="/user/reject.do"/>
            <mvc:mapping path="/approveList.do"/>
            <mvc:mapping path="/approveRental.do"/>
            <mvc:mapping path="/rejectRental.do"/>
            <mvc:mapping path="/approveExtend.do"/>
            <mvc:mapping path="/rejectExtend.do"/>
            <mvc:mapping path="/issueList.do"/>
            <mvc:mapping path="/reportConfirm.do"/>
            <mvc:mapping path="/reportStartRepair.do"/>
            <mvc:mapping path="/reportResolve.do"/>
            <mvc:mapping path="/reportReject.do"/>
            <mvc:mapping path="/reportImage.do"/>
            <mvc:mapping path="/equipmentForm.do"/>
            <mvc:mapping path="/equipmentRegister.do"/>
            <mvc:mapping path="/equipmentUpdate.do"/>
            <mvc:mapping path="/equipmentDelete.do"/>
            <mvc:mapping path="/categoryList.do"/>
            <mvc:mapping path="/categoryRegister.do"/>
            <mvc:mapping path="/categoryUpdate.do"/>
            <mvc:mapping path="/categoryDelete.do"/>
            <mvc:mapping path="/qrGenerate.do"/>
            <mvc:mapping path="/qrPrint.do"/>
            <mvc:mapping path="/qrImage.do"/>
            <bean class="egovframework.asset.cmmn.AdminCheckInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

    <!-- 세션 기반 로케일 저장 (브라우저 세션 동안 선택한 언어 유지) -->
    <bean id="localeResolver" class="org.springframework.web.servlet.i18n.SessionLocaleResolver"/>

    <!--
        [CommonsMultipartResolver]
        이미지/파일 업로드(multipart/form-data) 요청을 처리할 수 있게 해주는 설정.
        maxUploadSize: 파일 최대 크기 (바이트 단위, 여기선 5MB)
    -->
    <bean id="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <property name="maxUploadSize" value="5242880"/>
    </bean>

    <!--
        [예외 발생 시 이동할 뷰 매핑]
        SimpleMappingExceptionResolver: 예외 종류에 따라 보여줄 JSP를 지정합니다.
        뷰 이름 "cmmn/egovError" → ViewResolver가
        /WEB-INF/jsp/egovframework/asset/cmmn/egovError.jsp 로 변환합니다.
    -->
    <bean class="org.springframework.web.servlet.handler.SimpleMappingExceptionResolver">
        <property name="defaultErrorView" value="cmmn/egovError"/>
        <property name="exceptionMappings">
            <props>
                <prop key="org.springframework.dao.DataAccessException">cmmn/dataAccessFailure</prop>
                <prop key="org.springframework.transaction.TransactionException">cmmn/transactionFailure</prop>
                <prop key="org.egovframe.rte.fdl.cmmn.exception.EgovBizException">cmmn/egovError</prop>
            </props>
        </property>
    </bean>

    <!--
        [뷰 리졸버 (ViewResolver)]
        컨트롤러에서 return "user/login" 하면:
          prefix + "user/login" + suffix
          = /WEB-INF/jsp/egovframework/asset/ + user/login + .jsp
          = /WEB-INF/jsp/egovframework/asset/user/login.jsp
    -->
    <bean class="org.springframework.web.servlet.view.UrlBasedViewResolver"
          p:order="1"
          p:viewClass="org.springframework.web.servlet.view.JstlView"
          p:prefix="/WEB-INF/jsp/egovframework/asset/"
          p:suffix=".jsp"/>

</beans>